# CalcApp Environment Configuration
# Copy this file to .env and fill in actual values

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=localhost

# Database Configuration
DATABASE_PATH=./data/calcapp.db

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=24h

# Frontend API URL
REACT_APP_API_URL=http://localhost:3000/api/v1
REACT_APP_API_TIMEOUT=10000

# CORS Configuration
CORS_ORIGIN=http://localhost:3001

# Azure Configuration (for deployment)
AZURE_SUBSCRIPTION_ID=placeholder-subscription-id
AZURE_RESOURCE_GROUP=calcapp-rg-sandbox
AZURE_APP_NAME=calcapp-sandbox
